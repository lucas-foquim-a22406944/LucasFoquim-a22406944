{
  "model": "portfolio.makingof",
  "pk": 5,
  "fields": {
    "titulo": "Dificuldades com Migrações",
    "data": "2026-04-29",
    "descricao": "Durante a implementação da página \"Sobre\", tentei converter o campo tipo da classe Tecnologia de CharField para ForeignKey, criando uma nova classe TipoTecnologia. No entanto, a base de dados ficou com dados inválidos porque os valores existentes (ex: 'linguagem') não tinham correspondência na nova tabela. A solução foi reverter a alteração e manter o campo como CharField com choices, adicionando apenas os novos tipos necessários.",
    "imagem": "",
    "fase": "implementacao",
    "entidade_relacionada": "",
    "uso_ia": ""
  }
},
{
